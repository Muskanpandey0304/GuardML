# GuardML Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# Anthropic API key (required for agent loop)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model to use (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# MLflow tracking URI (SQLite for demo)
MLFLOW_TRACKING_URI=sqlite:///./demo/mlruns.db

# GuardML SQLite database path
GUARDML_DB=./guardml.db

# GuardML environment (staging | production)
# Server-controlled: clients cannot change it per request.
GUARDML_ENVIRONMENT=staging

# ---------------------------------------------------------------------------
# Authentication (REQUIRED - the API refuses to start without valid tokens)
# ---------------------------------------------------------------------------
# Format: name:token, comma-separated for several people.
#   GUARDML_USERS     -> can call /run, /session/*, /replay/*, /audit*, /postmortem
#   GUARDML_APPROVERS -> can also call POST /approvals/{id}
# Tokens must be at least 32 characters and must not be placeholders
# (changeme, password, etc.). Names and tokens must not contain ":" or ",".
# Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production, the approver must be a different identity from whoever
# started the session (two-person rule).
GUARDML_USERS=alice:PASTE_A_GENERATED_TOKEN_HERE
GUARDML_APPROVERS=bob:PASTE_A_DIFFERENT_GENERATED_TOKEN_HERE

# Token the Streamlit UI sends as "Authorization: Bearer <token>".
# Leave empty to type it into the UI login box instead. Never commit a real value.
GUARDML_API_TOKEN=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Default: the local Streamlit UI only. Never use "*".
GUARDML_CORS_ORIGINS=http://localhost:8501

# Max tool calls per agent session
GUARDML_MAX_TOOL_CALLS=10

# Approval timeout in seconds
GUARDML_APPROVAL_TIMEOUT=300

# GuardML API URL (for UI)
GUARDML_API_URL=http://localhost:8000

# Data directory
GUARDML_DATA_DIR=./demo/data

# Reports output directory
GUARDML_REPORTS_DIR=./reports
